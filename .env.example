# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; this template is committed.

# Firebase Web SDK (client) — fill these from the Firebase console:
# Project settings -> General -> Your apps -> SDK setup and configuration
# These are public by design: they ship inside the browser bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server) — SECRET. Never prefix these with NEXT_PUBLIC_.
# Project settings -> Service accounts -> "Generate new private key",
# then copy the three fields out of the downloaded JSON.
#
# FIREBASE_PRIVATE_KEY must keep its literal `\n` escapes and stay wrapped in
# double quotes — the loader un-escapes them. Pasting a key with real newlines
# breaks `.env` parsing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# OpenAI (server) — SECRET. Powers the Telegram AI agent.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Secret box key (server) — SECRET. Encrypts the per-user Telegram bot tokens
# before they are written to Firestore. 32 bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored bot token; users must reconnect.
SECRET_ENCRYPTION_KEY=

# The public origin Telegram should call back on. Optional: when unset, webhook
# registration uses the origin of the incoming request, which is correct in
# production. Set it while developing against a tunnel, e.g.
#   APP_BASE_URL=https://your-subdomain.trycloudflare.com
# Telegram refuses to register a webhook on localhost, so without a tunnel the
# bot stays connected but receives nothing locally.
APP_BASE_URL=

# Application
NEXT_PUBLIC_APP_ENV=development
